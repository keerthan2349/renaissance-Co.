---
// M03 · Founder. Assembled only from primitives + its own content (architecture
// rule 2). Ivory ground — the reading band between the dark hero and the
// sections below. Portrait slot is deferred (§13); the section stands as text.
import Section from '@/components/primitives/Section.astro';
import Rule from '@/components/primitives/Rule.astro';
import Eyebrow from '@/components/primitives/Eyebrow.astro';
import Heading from '@/components/primitives/Heading.astro';
import Body from '@/components/primitives/Body.astro';
import Reveal from '@/components/primitives/Reveal.astro';
import { founderContent } from './content';

const { eyebrow, heading, paras } = founderContent;
---
<Section id="founder">
  <Rule />
  <Reveal index={0}><Eyebrow>{eyebrow}</Eyebrow></Reveal>
  <Reveal index={1}><Heading>{heading}</Heading></Reveal>
  {paras.map((p, i) => (
    <Reveal index={2 + i}><Body>{p}</Body></Reveal>
  ))}
</Section>
