---
// M04 · The Refusal. Dark ground — a single navy band that spotlights the firm's
// strongest asset (the walk-away) between the ivory sections around it. Assembled
// only from primitives + its own content.
//
// BUILD RULE (§6): M04 and M10 (projects) must NEVER appear on the same page — an
// unnamed cautionary developer beside named partner developers is a collision.
// ENFORCED SINCE 28 JUL 2026: the projects carousel took the homepage, so this
// module MOVED OFF the homepage to its own page at /judgment. It is no longer in
// page-order.ts. Do not put it back on the homepage while the carousel is there.
//
// GROUND: dark by default (how it shipped on the homepage — a navy band between
// ivory sections). On /judgment it opens the page directly under the ivory header
// and is rendered ivory instead, so the page reads like the legal pages and the
// following contact section keeps the dark/ivory alternation.
import Section from '@/components/primitives/Section.astro';
import Rule from '@/components/primitives/Rule.astro';
import Eyebrow from '@/components/primitives/Eyebrow.astro';
import Heading from '@/components/primitives/Heading.astro';
import Lead from '@/components/primitives/Lead.astro';
import Body from '@/components/primitives/Body.astro';
import Reveal from '@/components/primitives/Reveal.astro';
import { refusalContent } from './content';

interface Props {
  dark?: boolean;
  headTop?: boolean;
}
const { dark = true, headTop = false } = Astro.props;
const { eyebrow, heading, lead, paras } = refusalContent;
---
<Section id="refusal" dark={dark} class={headTop ? 'refusal--top' : undefined}>
  <Rule />
  <Reveal index={0}><Eyebrow>{eyebrow}</Eyebrow></Reveal>
  <Reveal index={1}><Heading>{heading}</Heading></Reveal>
  {/* The correction line, moved here from the retired hero (client, 5 Aug 2026),
      and the reason this page is no longer only a story: the market claim now
      opens it, and the walk-away is the evidence under it. Set as Lead — the
      site's own standfirst — so it reads as this page's premise, not as a
      second heading. */}
  {lead && <Reveal index={2}><Lead>{lead}</Lead></Reveal>}
  {paras.map((p, i) => (
    <Reveal index={3 + i}><Body>{p}</Body></Reveal>
  ))}
</Section>

<style>
  /* When this section opens a page it must clear the fixed header.
     Overriding the --section-y TOKEN rather than padding-top is deliberate:
     Section sets `padding-block: var(--section-y)` from its own scoped rule,
     whose scope attribute gives it higher specificity than anything reachable
     from here — a plain padding-top override silently lost, leaving 11px of air
     on a phone. A custom property sidesteps specificity entirely, because
     Section's own declaration then resolves to this value.
     Driven by the header's live published height, with a fallback for the frame
     before its script runs. */
  :global(.refusal--top) { --section-y: calc(var(--header-h, 6rem) + var(--space-6)); }
</style>
