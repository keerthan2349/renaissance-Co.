---
// M05 · What we do. The firm stays for the hard part after the money moves.
// Assembled only from primitives + its own content.
//
// ⚠️ IVORY GROUND SINCE 6 AUG 2026 (client, chosen at /lab/sections/). It was
// navy from 28 Jul until then. The swap with M03 kept both BANDS where they
// were and traded only the copy, so this module's default ground had to flip
// with the page-order change — the two go together, and changing one alone
// inverts the page. This is now the quiet reading band straight after the
// shelf; the founder's record takes the navy emphasis band below it.
import Section from '@/components/primitives/Section.astro';
import Rule from '@/components/primitives/Rule.astro';
import Eyebrow from '@/components/primitives/Eyebrow.astro';
import Heading from '@/components/primitives/Heading.astro';
import Body from '@/components/primitives/Body.astro';
import Reveal from '@/components/primitives/Reveal.astro';
import { whatWeDoContent } from './content';

// The ground is a PROP (6 Aug 2026) so the pairing with M03 can be re-judged in
// the lab without moving any copy between files. ⚠️ The default IS the live
// page — flip it only alongside page-order.ts (see the note above).
interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;

const { eyebrow, heading, paras } = whatWeDoContent;
---
<Section id="what-we-do" dark={dark}>
  <Rule />
  <Reveal index={0}><Eyebrow>{eyebrow}</Eyebrow></Reveal>
  <Reveal index={1}><Heading>{heading}</Heading></Reveal>
  {paras.map((p, i) => (
    <Reveal index={2 + i}><Body>{p}</Body></Reveal>
  ))}
</Section>
