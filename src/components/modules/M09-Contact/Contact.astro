---
// M09 · Contact (§7.9). Phone is the conversion — given weight, not buried.
// WhatsApp is the fallback, styled navy/ivory — NEVER WhatsApp green (§7.9).
//
// LAYOUT: "The Invitation" (client's pick, 3 Aug 2026, chosen from four
// candidates at /lab/contact/): the human line leads as the section's heading,
// set in the EDITORIAL SERIF UPRIGHT (EB Garamond 500 — the client's face
// pick, replacing both the old Cinzel "Call us" heading and the lab's italic).
// The buttons follow, then one quiet row: hours · email · Instagram.
// "Call us" no longer appears as a visible heading — the line IS the heading
// (a real <h2>, so the page outline keeps a contact entry). The lab page
// remains as the comparison bench.
import Section from '@/components/primitives/Section.astro';
import Rule from '@/components/primitives/Rule.astro';
import Eyebrow from '@/components/primitives/Eyebrow.astro';
import Button from '@/components/primitives/Button.astro';
import Reveal from '@/components/primitives/Reveal.astro';
import Icon from '@/components/primitives/Icon.astro';
import { site } from '@/data/site';
// Its words live in this module's own content file (architecture rule 1), the
// channels in the site-wide control room. Copy belongs to the module; facts
// belong to the site.
import { contactContent } from './content';

const { phone, phoneDisplay, whatsapp, hours, email, instagramUrl, instagramLabel } = site.contact;
const { eyebrow, line } = contactContent;
---
<Section id="contact" dark>
  <Rule />
  <Reveal index={0}><Eyebrow>{eyebrow}</Eyebrow></Reveal>
  <Reveal index={1}>
    <h2 class="contact__line">
      {line.map((part, i) => (
        <>
          {i > 0 && <br />}
          {part}
        </>
      ))}
    </h2>
  </Reveal>

  {/* The `data-track` attributes below are the stable hooks M17 (Meta plumbing)
      attaches to. Inert until that module exists — see
      vault/website/m17-meta-plumbing.md. Marking them now means the tracking
      module never has to edit this file, so modules stay independent. */}
  <div class="contact__actions reveal" style="--i:2">
    {
      phone && phoneDisplay ? (
        <Button
          href={`tel:${phone}`}
          variant="primary"
          weight="heavy"
          aria-label={`Call ${phoneDisplay}`}
          data-track="call"
        >
          <Icon name="phone" /> {phoneDisplay}
        </Button>
      ) : (
        <span class="todo-pill" title="Add a business phone number in src/data/site.ts">
          TODO · business phone
        </span>
      )
    }

    {
      whatsapp ? (
        <Button
          href={`https://wa.me/${whatsapp}`}
          variant="ghost"
          rel="noopener"
          target="_blank"
          data-track="whatsapp"
        >
          <Icon name="whatsapp" /> WhatsApp
        </Button>
      ) : (
        <span class="todo-pill" title="Add a WhatsApp Business number in src/data/site.ts">
          TODO · WhatsApp
        </span>
      )
    }
  </div>

  {/* One quiet row beneath the buttons — the phone stays the conversion.
      Instagram reads as the word, not the @handle (client, 28 Jul) — change
      `instagramLabel` in site.ts to show the handle. Unset a channel in
      site.ts and it disappears from this row cleanly. */}
  <Reveal index={3}>
    <div class="contact__meta">
      <span>{hours}</span>
      {
        email && (
          <a class="contact__quiet" href={`mailto:${email}`} data-track="email">
            <Icon name="mail" /> {email}
          </a>
        )
      }
      {
        instagramUrl && (
          <a
            class="contact__quiet"
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-track="instagram"
          >
            <Icon name="instagram" /> {instagramLabel}
          </a>
        )
      }
    </div>
  </Reveal>
</Section>

<style>
  /* The invitation line — the section's heading, in the editorial serif
     upright (client's face pick, 3 Aug). The size clamp was tuned in the lab
     so the line carries display weight without Cinzel's formality. */
  .contact__line {
    font-family: var(--font-body);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(1.75rem, 3.6vw, 2.9rem);
    line-height: 1.3;
    letter-spacing: 0;
    margin: 0;
    max-width: 26em;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-1);
  }
  .todo-pill {
    font-family: var(--font-util);
    font-size: var(--type-eyebrow);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: color-mix(in srgb, var(--ivory) 70%, transparent);
    border: 1px dashed color-mix(in srgb, var(--ivory) 45%, transparent);
    padding: 0.9em 1.4em;
    border-radius: 2px;
  }

  /* The quiet row: hours, then the two soft channels, on one wrapping line. */
  .contact__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    font-family: var(--font-util);
    font-size: var(--type-caption);
    color: color-mix(in srgb, var(--ivory) 78%, transparent);
    margin: 0;
  }
  .contact__quiet {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    text-underline-offset: 2px;
    color: inherit;
    overflow-wrap: anywhere;
  }
  .contact__quiet > :global(.icon) { opacity: 0.85; }
  .contact__quiet:hover { text-decoration: underline; }

  /* Narrow screens: stack the actions so nothing overflows the edge. */
  @media (max-width: 30rem) {
    .contact__actions { flex-direction: column; align-items: flex-start; }
  }
</style>
