---
// M10 · Projects — the homepage carousel. Dark ground.
//
// A preview of /projects: swipeable cards, each linking to that project's own
// detail page. Renders nothing at all when there are no projects, so the
// homepage simply doesn't have this section until the client supplies the list.
//
// MOTION: it advances slowly on its own, yields to the visitor the instant they
// touch it, and resumes once they have left it alone (client's instruction,
// 28 Jul 2026). This DELIBERATELY OVERRIDES the motion rule against looping
// movement — recorded in the vault and the repo rulebook, not an oversight.
// Movement is still native CSS scroll-snap (so a phone swipe is the real thing);
// the script only nudges the track. No library.
// The safeguards are not optional — see the script block at the bottom.
//
// TYPE ON IMAGES (§8.5): text never sits on image detail. Each card carries a
// navy scrim that the type sits on, so it stays legible over any photograph.
//
// NOTE ON THE PAGE IT SITS IN: M04 'refusal' was moved OFF the homepage to
// /judgment when this went on, because the two may not share a page (§6 build
// rule) — an unnamed developer as the cautionary tale beside named partner
// developers is a collision. Client decision, 28 Jul 2026.
import Section from '@/components/primitives/Section.astro';
import Eyebrow from '@/components/primitives/Eyebrow.astro';
import Heading from '@/components/primitives/Heading.astro';
import Reveal from '@/components/primitives/Reveal.astro';
import Marquee from '@/components/primitives/Marquee.astro';
import { projects, projectsContent } from '@/data/projects';
import { backdropRows, BACKDROP_REPEAT } from './backdrop';

const { carouselEyebrow, carouselHeading, carouselAll, labels } = projectsContent;
---
{projects.length > 0 && (
  <Section id="projects" dark class="projects--feature">
    {/* The marquee backdrop (client-approved 2 Aug 2026). It rides in
        Section's `backdrop` slot, which renders full-bleed behind the content
        column and takes no pointer events, so the carousel above it keeps
        every tap, swipe and arrow click. Settings live in ./backdrop.ts.
        The blur pair below is the client's locked ramp (6 Aug): soft in the
        middle — the numbers they set in the lab against THIS section's
        2.65rem type. (Comment moved OUT of the attribute list, 11 Aug: a
        comment between attributes parses in the compiler but breaks
        `astro check` — the recorded 29 Jul trap.) */}
    <Marquee
      slot="backdrop"
      rows={backdropRows}
      repeat={BACKDROP_REPEAT}
      background
      blur={{ from: '1.4px', to: '4.3px' }}
      class="projects__marquee"
    />

    {/* NO <Rule /> here (client, 2 Aug 2026). The drawn gold hairline opens
        every other section — it is the site's signature (blueprint §5) — but
        this is the one section with a marquee behind it, and a gold line laid
        across moving text reads as two ornaments fighting rather than as one.
        The ivory → gradient colour change still marks the section boundary on
        its own. Do not re-add it without the client asking. */}
    {/* .carousel__head groups the eyebrow + heading so a single panel can sit
        behind them (the lab is trialling a backdrop blur there — the marquee
        was overlapping the heading text). The wrapper is PIXEL-NEUTRAL here:
        it recreates section__inner's own flex gap, and carries no visual style
        of its own on the live site. */}
    <div class="carousel__head">
      <Reveal index={0}><Eyebrow>{carouselEyebrow}</Eyebrow></Reveal>
      <Reveal index={1}><Heading>{carouselHeading}</Heading></Reveal>
    </div>

    <Reveal index={2}>
      <div class="carousel" data-carousel>
        {/* `data-carousel-track`, NOT `data-track`: the latter is the Meta
            plumbing hook (data-track="call" etc.), and the two collided — a bare
            [data-track] query matched the header's phone button instead of this
            list, which silently killed the arrows. Keep the names distinct. */}
        <ul class="carousel__track" role="list" data-carousel-track tabindex="0" aria-label={carouselHeading}>
          {projects.map((p) => (
            <li class="carousel__item">
              <a class="card" href={`/properties/${p.slug}`}>
                <div class="card__media">
                  {p.image ? (
                    <img class="card__img" src={p.image} alt={p.imageAlt ?? ''} loading="lazy" decoding="async" />
                  ) : (
                    <span class="card__blank" aria-hidden="true"></span>
                  )}
                  <span class="card__scrim" aria-hidden="true"></span>

                  {/* Completion badge, top-left — a navy chip, not a colour pop:
                      the reference card's pill, in this brand's palette. */}
                  <p class="card__badge">{labels.completion}: {p.handover}</p>

                  <div class="card__text">
                    <p class="card__developer">{p.developer}</p>
                    <h3 class="card__project">{p.project}</h3>
                    <p class="card__meta">
                      <svg class="card__pin" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                        <path d="M12 21s-7-5.5-7-11a7 7 0 1 1 14 0c0 5.5-7 11-7 11Z" />
                        <circle cx="12" cy="10" r="2.6" />
                      </svg>
                      {p.area}
                    </p>

                    {/* NO price on the card — client's call (28 Jul): the carousel
                        stays clean; the price appears on the property's own page
                        (and the /projects list) once clicked through. */}
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>

        <div class="carousel__foot">
          <div class="carousel__arrows">
            <button type="button" class="arrow" data-prev aria-label="Previous projects">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M15 5 8 12l7 7" stroke-linecap="square" />
              </svg>
            </button>
            <button type="button" class="arrow" data-next aria-label="Next projects">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="m9 5 7 7-7 7" stroke-linecap="square" />
              </svg>
            </button>
          </div>
          <a class="carousel__all" href="/properties">{carouselAll}</a>
        </div>
      </div>
    </Reveal>
  </Section>
)}

<style>
  /* THE FEATURE GROUND (client, 28 Jul): this section carries a gradient rather
     than the flat navy every other dark section uses, because it is the one the
     client most wants clients to land on.
     Built ONLY from the fixed palette — no colour is added (§4.1): a warm
     gold-deep tint at the top-left settling into navy and then a deepened navy.
     Gold as a background is one of the two uses gold is allowed.
     Set through the --ground-dark TOKEN, not a background override: Section's
     own `.section--dark { background: var(--ground-dark) }` is a scoped rule
     that outranks anything reachable from here, so a direct background would
     silently lose. Overriding the token means Section's own declaration
     resolves to this. (Same technique as M04's page-top padding.) */
  /* Declared a size container so the track can be measured against the
     SECTION's width in pure CSS (`cqw`), not the viewport's (`vw`). The
     difference is the scrollbar: `100vw` is ~15px wider than the page, which
     put the first card 8px left of the heading on every screen. `cqw` is
     exact, needs no JavaScript, and is therefore right from the very first
     paint — which matters, because applying the offset later lets the
     browser's scroll-anchoring nudge the track and re-settle it on card two
     (measured: it loaded at 360px with the back arrow live at 1920px). */
  :global(.projects--feature) {
    container-type: inline-size;
    /* ⚠️ THE GROUND NOW MATCHES THE HERO EXACTLY (client, 6 Aug: "the
       background of the marquee is not matching the hero section blue — match
       that"). It is plain `--navy`, the identical colour the hero ends on.
       MEASURED, which is how the fault was confirmed rather than guessed: the
       old gold-tinted gradient painted #0a1440 at the join but #181c38 by the
       marquee zone — red climbing 10→24 and blue falling 64→56, i.e. a warmer,
       muddier blue than the hero's. No seam treatment can reconcile two fields
       that are simply different colours; this is the actual fix for the
       boundary reading as a break.
       ⚠️ THIS RETIRES THE SITE'S ONE GRADIENT — the gold-deep "feature ground"
       the client chose on 28 Jul to mark this as the section they most want
       people to land on. Superseded by their own instruction above. It is kept
       one chip away in the lab (`data-ground='glow'`) and is one line to
       restore. Written as a plain colour, never `color-mix()`: the glass
       header's ground test matches `rgb(…)` only (recorded trap). */
    --ground-dark: var(--navy);
  }

  /* 🔬 LAB ONLY — the retired feature gradient, kept switchable for comparison
     so the client can see what the match cost them. Not reachable on the live
     page (no `data-ground` attribute is ever set there). */
  :global(.projects--feature[data-ground='glow']) {
    --ground-dark:
      /* Literal, not `var(--seam-melt)`: that variable is gone with the seam
         work, and this comparison must stay self-contained. */
      linear-gradient(to bottom, var(--navy) 0, transparent clamp(4rem, 14svh, 10rem)),
      radial-gradient(
        125% 105% at 8% 0%,
        color-mix(in srgb, var(--gold-deep) 26%, var(--navy)) 0%,
        color-mix(in srgb, var(--gold-deep) 11%, var(--navy)) 38%,
        var(--navy) 78%
      );
  }

  /* ⚠️ THE FOUR SEAM TREATMENTS (melt variants · cut · gold thread · bloom)
     WERE REMOVED ON 6 AUG at the client's word: "as the background is the same
     there is no need to add another seamless transition." Once the shelf's
     ground became the hero's exact navy the boundary disappeared on its own,
     and every treatment was solving a problem that no longer existed. The last
     remnant — the marquee's letters fading in below the join — went the same
     day on the same reasoning ("I don't want any transition … the background
     already blends"). `--seam-melt` is gone entirely. Do not rebuild any of it
     speculatively: the boundary is invisible because the two grounds are the
     same colour, which is the only mechanism needed. */

  /* THE MARQUEE BACKDROP — the client's approved settings, 2 Aug 2026.
     Reasoning for each number, and why three of them are not the literal value
     they set on desktop, is written up in ./backdrop.ts.

     Everything is expressed relative to the type size (em) or to the viewport
     (vw/%) so the whole thing scales as one object. The one width the client
     actually judged it at is 1280px, where 3.3vw resolves to exactly the
     2.65rem they chose. */
  :global(.projects__marquee) {
    --mq-size-base: clamp(1.6rem, 3.3vw, 2.65rem);
    --mq-gap: 1.23em;
    --mq-tracking: 0.02em;
    --mq-row-gap: 0.6em;
    /* 0 — REMOVED at the client's ask, 6 Aug ("remove the blue edge fade … it
       doesn't suit anymore"): once the whole field was blurred, the side fades
       read as a blue vignette instead of a soft exit. The rows now run to the
       screen edges and cut there, which is the honest edge for an edge-to-edge
       section. (History: 3% → 13% on 3 Aug, their number then too.) */
    --mq-fade: 0%;
    /* 0.23 (client's final numbers, 3 Aug; was 0.38 → 0.24 → this). At 20 rows
       there is roughly three times the ink of the sparse field 0.38 was first
       judged against, so small steps read larger than they sound. */
    --mq-opacity-base: 0.23;
    --mq-sep: '·';
    /* 1px at the desktop size they approved. In em so it thins with the type
       rather than turning the outline solid on a phone — floored at 0.7px,
       below which a hairline stroke starts dropping out on 1x screens. */
    --mq-stroke: max(0.7px, 0.024em);
    /* ⚠️ NO VERTICAL FADE AT THE TOP — removed 6 Aug at the client's word: "I
       don't want any transition between hero and this marquee section because
       the background already blends and it's fine." It had been the last
       remnant of the seam work, fading the letters in below the join. With the
       shelf's ground now the hero's exact navy there is nothing to bridge, and
       a fade over an already-invisible boundary only softened the marquee's
       own top edge for no reason. The rows keep their own horizontal edge
       behaviour; nothing masks the marquee as a whole any more. */
  }

  /* THE MARQUEE'S BLUR GRADIENT (client, 6 Aug: "a blur gradient from 0px to
     2px for the marquee"). It ramps DOWN THE STACK rather than sitting flat.
     ⚠️ 🔬 THE SHAPE IS STILL IN THE LAB — `data-blur` on the section switches
     it at /lab/hero. Without the attribute this is the shipped default (top
     sharp → bottom soft), so the live page is one settled thing while they
     judge; nothing is half-applied.

     HOW, and why it costs nothing: `filter: blur()` cannot itself take a
     gradient, and the usual workaround is stacking N masked copies — which is
     what the glass header does with backdrop layers. Here it is free: the
     marquee is already 20 stacked rows, so each row simply takes its own blur
     from its index (`--mq-i` / `--mq-n`, published by the primitive). 20 steps
     across 0→2px is a 0.1px increment — smooth, with ZERO extra DOM and no
     second copy of anything.

     The blur stays on the TRACK: its content never changes, it only
     translates, so the compositor rasterises each blurred row once and slides
     it. On the row or the root it would re-rasterise every frame of the crawl.
     Scoped to THIS marquee — the PageBand's and the labs' stay sharp. */
  /* ✅ THE CLIENT'S LOCKED BLUR (6 Aug 2026): soft in the middle, 1.4px → 4.3px.
     THE RAMP ITSELF NOW LIVES IN THE MARQUEE PRIMITIVE — the properties band
     wanted the same treatment, and a second copy of the maths would drift the
     first time one was tuned. The numbers are passed as a prop above, because
     they are specific to THIS section's 2.65rem type; the band passes smaller
     ones for its 1.2rem.
     🔬 Only the alternative SHAPES stay here, for retuning at /lab/hero — none
     is ever set on the live page. They override --t, which the primitive
     declares at a lower specificity precisely so this works. */
  :global(.projects--feature[data-blur='down'] .marquee__row) { --t: var(--u); }
  :global(.projects--feature[data-blur='up'] .marquee__row) { --t: calc(1 - var(--u)); }
  :global(.projects--feature[data-blur='edges'] .marquee__row) {
    --t: max(var(--c), calc(-1 * var(--c)));
  }
  :global(.projects--feature[data-blur='flat'] .marquee__row) { --t: 1; }

  /* THE HEADING PANEL (client-approved 3 Aug, tuned in the lab): a gentle
     backdrop blur behind CURATED → "On the shelf", because the marquee text
     behind was overlapping the heading text. 2px is deliberate — enough to
     soften the collision, not enough to read as frosted glass.
     The panel bleeds outward via padding + equal negative margins (net-zero
     to layout), its top/bottom edges FADE via the mask ("seamless"), and its
     corners are slightly rounded (client's ask). Horizontal bleed stays at
     1.25rem — the gutter's minimum — so it can never poke past the section
     edge on a narrow phone; the section's own overflow:hidden backstops it.
     Tunables are var()-with-fallback so the lab can drive them live — a
     component's defaults must never outrank its caller (the marquee bug). */
  .carousel__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    /* Default DOWN from 2px to 0 (client, 6 Aug): the whole marquee now carries
       the 2px blur itself, and keeping the panel's backdrop blur on top made
       the heading zone a visibly softer rectangle against the uniform field —
       the exact non-uniformity the client asked to remove. The panel structure
       stays (the lab's slider still drives --head-blur live); one word turns
       it back up if the heading ever needs extra help. */
    backdrop-filter: blur(var(--head-blur, 0px));
    -webkit-backdrop-filter: blur(var(--head-blur, 0px));
    padding: 1.5rem 1.25rem 2rem;
    margin: -1.5rem -1.25rem -2rem;
    border-radius: 1rem;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 1.25rem,
      #000 calc(100% - 1.6rem),
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 1.25rem,
      #000 calc(100% - 1.6rem),
      transparent 100%
    );
  }

  /* ── WIDTH OF THE TRACK — EDGE TO EDGE, FLUSH (client, 4 Aug 2026) ──────
     The row runs the full width of the screen and the first card starts at
     the screen's edge. Chosen at /lab/carousel/, where the alternative
     ("aligned", first card lined up with the heading) is still available for
     comparison.

     THE OFFSET CARRIES NO PERCENTAGES, deliberately. A percentage resolves
     against the containing block in `padding-inline` but against the
     SCROLLPORT in `scroll-padding-inline` — the same expression computed to
     120px for one and 0 for the other, and snapping then dragged the first
     card flush while the track rested at 121px. `cqw` (the section is a size
     container) + `rem` resolve identically in both. It also avoids `vw`,
     which includes the scrollbar and left the row 8px off the column.

     ⚠️ HISTORY WORTH KEEPING: this track WAS full-bleed once and was pulled
     back into the content box on 28 Jul, because padding on a scrolling
     container shifts where the first card comes to rest — it loaded at a
     non-zero scroll position and the "previous" arrow looked available before
     the visitor had moved. Any change here must still prove two things at
     several widths: the track rests at exactly 0, and the back arrow starts
     disabled. Both are covered by the checks that shipped this. */
  .carousel {
    --card-w: min(78%, 24rem);
    /* Distance from the content column's edge to the screen's edge. */
    --carousel-edge: max(var(--gutter), calc((100cqw - 72rem) / 2 + var(--gutter)));
    --carousel-bleed: calc(-1 * var(--carousel-edge));
    /* 0 = flush (the client's pick). Set to var(--carousel-edge) for the
       "aligned" variant, where the first card lines up with the heading. */
    --carousel-pad: 0px;
  }

  .carousel__track {
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    padding-bottom: var(--space-2);
    margin-inline: var(--carousel-bleed, 0px);
    padding-inline: var(--carousel-pad, 0px);
    scroll-padding-inline: var(--carousel-pad, 0px);
    /* A quiet scrollbar rather than none — hiding it removes the affordance. */
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--ivory) 28%, transparent) transparent;
  }

  /* NO scroll-snap while the carousel crawls. Snapping and continuous motion are
     incompatible: mandatory snap drags the track back to the nearest card on
     every frame, so it either judders or never moves. Since the crawl means
     cards are never card-aligned anyway, alignment isn't a concept here.
     Under reduced motion nothing moves on its own, so snapping becomes useful
     again and is restored — that is the one case it helps. */
  @media (prefers-reduced-motion: reduce) {
    /* `proximity`, not `mandatory`. Mandatory snap FORCES a snap position at
       rest, and with any scroll-padding on the container it can choose the
       second card rather than the first — measured at 1920px: the track
       loaded at 360px with the back arrow live, which is precisely the
       regression that pulled this layout back into the content column in
       July. Proximity still snaps when the visitor lets go near a card, and
       leaves a resting track alone. */
    .carousel__track { scroll-snap-type: x proximity; }
    .carousel__item { scroll-snap-align: start; }
  }
  .carousel__track:focus-visible { outline: 2px solid var(--gold-highlight); outline-offset: 4px; }

  .carousel__item {
    flex: 0 0 var(--card-w);
  }

  .card { display: block; height: 100%; }

  .card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: color-mix(in srgb, var(--ivory) 8%, var(--navy));
    /* Thin gold outline (client-approved 3 Aug): the palette's on-dark gold —
       the same gold as the CURATED eyebrow — at 0.5px/65%. Hairline, not a
       frame; hi-dpi screens render the true half-pixel, 1x rounds it. Gold as
       a border is one of the two uses gold is allowed (§8.2). */
    border: var(--card-line, 0.5px) solid
      color-mix(in srgb, var(--gold-highlight) var(--card-line-strength, 65%), transparent);
  }
  .card__img,
  .card__blank {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform var(--dur-section) var(--ease);
  }
  /* A restrained rise on hover — no lift, no shadow, no scale on the card itself. */
  .card:hover .card__img { transform: scale(1.03); }

  /* §8.5 — type sits on a settled navy band, never on image detail. The scrim
     runs a little higher than before because the text block now includes the
     price row. */
  .card__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      var(--navy) 0%,
      color-mix(in srgb, var(--navy) 86%, transparent) 40%,
      transparent 72%
    );
  }

  /* Completion chip, top-left — the reference card's pill in this palette:
     a near-solid navy ground so the type never sits on image detail (§8.5). */
  .card__badge {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    margin: 0;
    padding: 0.45em 0.9em;
    border-radius: 999px;
    background: color-mix(in srgb, var(--navy) 88%, transparent);
    border: 1px solid color-mix(in srgb, var(--ivory) 22%, transparent);
    color: var(--ivory);
    font-family: var(--font-util);
    font-size: var(--type-caption);
    letter-spacing: 0.03em;
  }

  .card__text {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--space-3);
    color: var(--ivory);
  }
  .card__developer {
    font-family: var(--font-util);
    font-size: var(--type-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--gold-highlight);
    margin: 0 0 var(--space-1);
  }
  .card__project {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    font-weight: 400;
    margin: 0 0 0.4rem;
  }
  .card__meta {
    display: flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-util);
    font-size: var(--type-caption);
    color: color-mix(in srgb, var(--ivory) 82%, transparent);
    margin: 0;
  }
  .card__pin { flex: 0 0 auto; }
  .card:hover .card__project { text-decoration: underline; text-underline-offset: 3px; }


  .carousel__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .carousel__arrows { display: flex; gap: var(--space-1); }

  .arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--ivory);
    border: 1px solid color-mix(in srgb, var(--ivory) 36%, transparent);
    border-radius: 2px;
    transition:
      border-color var(--dur-micro) var(--ease),
      opacity var(--dur-micro) var(--ease);
  }
  .arrow:hover { border-color: var(--ivory); }
  .arrow[disabled] { opacity: 0.3; cursor: default; }
  .arrow[disabled]:hover { border-color: color-mix(in srgb, var(--ivory) 36%, transparent); }


  .carousel__all {
    font-family: var(--font-util);
    font-size: var(--type-caption);
    letter-spacing: 0.04em;
    color: var(--ivory);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: color-mix(in srgb, var(--gold-highlight) 70%, transparent);
  }
  .carousel__all:hover { text-decoration-color: var(--gold-highlight); }
</style>

<script>
  // The carousel CRAWLS: one continuous glide at a constant rate, not a jump
  // every few seconds. It stops the instant the visitor touches it and picks up
  // again from exactly where it stopped (client's instruction, 28 Jul 2026 —
  // deliberately overriding the motion rule against looping movement; recorded
  // in the vault and the repo rulebook).
  //
  // Constant speed means distance comes from real elapsed time, so it looks the
  // same on a 60Hz and a 120Hz screen. Scroll-snap is off while it crawls —
  // snapping would drag it back to the nearest card every frame.
  //
  // It stops itself in every situation where continuing would be wrong:
  //   · the visitor has asked for reduced motion  → never starts at all
  //   · the visitor swiped, clicked or keyed      → paused, resumes when idle
  //   · keyboard focus is inside it               → paused (focus is deliberate)
  //   · scrolled out of view                      → paused (nothing moves in
  //     the corner of the eye while they read something else)
  //   · browser tab is in the background          → paused (no wasted battery)
  //
  // NO stop/start button and NO hover-pause — both removed on the client's
  // instruction (28 Jul). See the accessibility note in the vault module doc:
  // reduced-motion remains the way a visitor turns this off for good.
  function initCarousel() {
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
      const track = root.querySelector<HTMLElement>('[data-carousel-track]');
      const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
      const next = root.querySelector<HTMLButtonElement>('[data-next]');
      if (!track || !prev || !next) return;
      if ((track as any).__wired) return; // survive View Transitions re-inits
      (track as any).__wired = true;

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      const SPEED = 26; // pixels per second — the constant crawl. Tune here.
      const RESUME_MS = 2500; // quiet time after an interaction before it resumes

      let raf: number | null = null;
      let lastTs = 0;
      let pos = 0; // float position: at 26px/s a frame moves <0.5px, which would
      //              round away to nothing if we incremented scrollLeft directly
      let period = 0; // the width of ONE full set of cards, gap included
      let resumeTimer: number | null = null;
      let busy = false; // focused, or recently interacted with
      let focused = false; // keyboard focus inside — wrapping pauses too, see below
      let onScreen = false;

      // ---- THE ENDLESS CIRCLE (client, 6 Aug 2026) --------------------------
      // "If it reaches the end the first property should be seen again." Same
      // mechanism as the marquee: the card set is DUPLICATED, and scrolling is
      // kept inside the band [period, 2·period) by teleporting exactly one
      // period — which is invisible by construction, because the content is
      // periodic. This replaces the old reverse-at-each-end behaviour: a circle
      // has no ends. (A wrap that jumped to a DIFFERENT picture was rejected on
      // 28 Jul as reading like a glitch; a wrap that lands on identical pixels
      // is not a jump at all.)
      //
      // Clones are presentation only: aria-hidden, links untabbable — a screen
      // reader and the Tab key still see each property exactly once. They still
      // CLICK fine (tabindex -1 removes tab order, not the link).
      const originals = [...track.children] as HTMLElement[];
      const setCount = originals.length;
      const addSet = () => {
        for (const li of originals) {
          const c = li.cloneNode(true) as HTMLElement;
          c.setAttribute('aria-hidden', 'true');
          c.querySelectorAll('a').forEach((a) => a.setAttribute('tabindex', '-1'));
          track.appendChild(c);
        }
      };
      const ensureLoop = () => {
        if (setCount === 0) return;
        if (track.children.length === setCount) addSet();
        // The period is MEASURED (first card of set 2 minus first card of set
        // 1), never summed from widths — offsetLeft carries the gaps exactly.
        period =
          (track.children[setCount] as HTMLElement).offsetLeft -
          (track.children[0] as HTMLElement).offsetLeft;
        if (period <= 0) return;
        // Enough copies that the whole wrap band plus a full viewport always
        // exists inside the real scroll range — the marquee's top-up lesson
        // (2 Aug): a copy count that is ample at one size is a bare gap at
        // another, so it is measured, not assumed.
        while (track.scrollWidth < 2.5 * period + 2 * track.clientWidth) addSet();
      };
      // Keep scrolling inside the band. Skipped while keyboard focus is inside:
      // a teleport moves the focused element physically, and the browser's own
      // scroll-to-focused would fight it — focusout normalizes instead.
      const normalize = () => {
        if (period <= 0 || focused) return;
        let x = track.scrollLeft;
        if (x >= period && x < 2 * period) return;
        while (x < period) x += period;
        while (x >= 2 * period) x -= period;
        track.scrollLeft = x;
        pos = x;
      };
      ensureLoop();
      // Scroll anchoring once re-settled this track on card two after a late
      // layout change (the /lab/carousel find) — appending clones is exactly
      // that kind of change, so anchoring is off before the start position is
      // set.
      track.style.overflowAnchor = 'none';
      // Start one period in: pixel-identical to the old start, and the circle
      // can immediately be walked backwards too.
      track.scrollLeft = period;
      pos = period;

      const step = () => {
        const card = track.querySelector<HTMLElement>('.carousel__item');
        const gap = parseFloat(getComputedStyle(track).columnGap || '0') || 0;
        return card ? card.offsetWidth + gap : track.clientWidth * 0.8;
      };
      const go = (d: number) => {
        // Pre-wrap so a smooth arrow step can never cross the band edge in
        // flight: setting scrollLeft mid-animation cancels the glide and it
        // would land abruptly. One card step is at most a quarter period, so
        // after these teleports the target is always comfortably inside.
        if (period > 0) {
          if (d > 0 && track.scrollLeft > 1.7 * period) { track.scrollLeft -= period; pos = track.scrollLeft; }
          if (d < 0 && track.scrollLeft < 1.3 * period) { track.scrollLeft += period; pos = track.scrollLeft; }
        }
        track.scrollBy({ left: d * step(), behavior: reduce.matches ? 'auto' : 'smooth' });
      };

      const mayRun = () =>
        !busy && onScreen && !reduce.matches && !document.hidden && period > 4;

      // One continuous crawl at a constant rate — distance is derived from real
      // elapsed time, so the speed is identical on a 60Hz and a 120Hz screen and
      // doesn't lurch after a stall. FORWARD ONLY since 6 Aug (client): the
      // circle has no ends, so there is nothing to reverse at — crossing the
      // band edge teleports back one period onto identical pixels.
      const frame = (ts: number) => {
        if (!mayRun()) { raf = null; return; }
        if (!lastTs) lastTs = ts;
        const dt = Math.min((ts - lastTs) / 1000, 0.05); // clamp after a tab stall
        lastTs = ts;

        pos += SPEED * dt;
        if (pos >= 2 * period) pos -= period;
        track.scrollLeft = pos;

        raf = requestAnimationFrame(frame);
      };

      const stopAuto = () => {
        if (raf !== null) { cancelAnimationFrame(raf); raf = null; }
        lastTs = 0;
      };
      const startAuto = () => {
        stopAuto();
        if (!mayRun()) return;
        pos = track.scrollLeft; // resume from wherever it actually is now
        raf = requestAnimationFrame(frame);
      };

      // Any deliberate interaction hands over control and restarts the idle clock.
      const interacted = () => {
        busy = true;
        stopAuto();
        if (resumeTimer !== null) clearTimeout(resumeTimer);
        resumeTimer = window.setTimeout(() => { busy = false; startAuto(); }, RESUME_MS);
      };

      prev.addEventListener('click', () => { interacted(); go(-1); });
      next.addEventListener('click', () => { interacted(); go(1); });

      // Pointer/touch/keyboard on the track itself counts as taking control.
      // Listening to these rather than the scroll event avoids mistaking the
      // carousel's own programmatic scrolling for the visitor's.
      ['pointerdown', 'touchstart', 'wheel', 'keydown'].forEach((evt) =>
        track.addEventListener(evt, interacted, { passive: true }),
      );

      // NOTE: hovering does NOT pause. It used to, and that was a mistake — a
      // reader's cursor commonly just sits somewhere in the middle of the page,
      // which meant the carousel often never moved at all. "Interacts with it"
      // means deliberately swiping, clicking or keying, not the mouse happening
      // to rest over it. Keyboard focus still pauses, because that IS deliberate.
      const release = () => {
        if (resumeTimer !== null) clearTimeout(resumeTimer);
        resumeTimer = window.setTimeout(() => { busy = false; startAuto(); }, 400);
      };
      root.addEventListener('focusin', () => { busy = true; focused = true; stopAuto(); });
      root.addEventListener('focusout', () => { focused = false; normalize(); release(); });

      // Only while it is actually on screen. A forgiving threshold: it should
      // start as soon as a reasonable part of it is showing, not only when it is
      // near-centred.
      const io = new IntersectionObserver(
        (entries) => {
          onScreen = entries[0].isIntersecting;
          if (onScreen) startAuto();
          else stopAuto();
        },
        { threshold: 0.2 },
      );
      io.observe(root);

      // Never in a background tab.
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stopAuto();
        else startAuto();
      });

      // The arrows never disable any more: a circle always has a next and a
      // previous. (The old rest-at-0-with-back-arrow-greyed contract is
      // superseded by the client's endless-loop instruction, 6 Aug.)
      prev.disabled = false;
      next.disabled = false;
      // The wrap itself: any scroll that leaves the band — a fling, a wheel, a
      // scrollbar drag — is teleported back onto identical pixels. The one
      // honest cost: a touch fling that crosses the boundary loses its
      // remaining momentum (browsers kill momentum when scrollLeft is set).
      // With a period this wide that crossing is rare, and the alternative was
      // a visible hard stop at a real end.
      track.addEventListener('scroll', normalize, { passive: true });
      window.addEventListener('resize', () => {
        // Card widths are viewport-relative on phones, so the PERIOD moves
        // with a resize — re-measure, top the copies up if the viewport grew,
        // and re-seat the position inside the new band.
        ensureLoop();
        normalize();
        startAuto();
      }, { passive: true });

      // If the visitor turns reduced motion on mid-visit, stop immediately.
      reduce.addEventListener?.('change', () => { if (reduce.matches) stopAuto(); else startAuto(); });
    });
  }

  document.addEventListener('astro:page-load', initCarousel);
  document.addEventListener('DOMContentLoaded', initCarousel);
  initCarousel();
</script>
