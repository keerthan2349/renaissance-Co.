---
// M10 · Projects — one property's page at /projects/<slug>. REDESIGNED 28 Jul
// 2026 with the grid: the projects area is its own visual family — same palette
// and rules as the main site, different UI. Here that means a navy header band
// carrying the title and a facts strip (area · completion · units · price),
// Inter leading throughout, and EB Garamond kept for exactly one thing: the
// "why it is on the shelf" line, set as the page's centrepiece.
//
// Still no invented content: everything renders from the project's entry in
// src/data/projects.ts. No return claims, never "guaranteed". The price is
// printed verbatim and dated (§10).
import Reveal from '@/components/primitives/Reveal.astro';
import { projectsContent, type Project } from '@/data/projects';

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
const { labels, detailBack } = projectsContent;

const facts: { label: string; value: string; note?: string }[] = [
  { label: labels.area, value: p.area },
  { label: labels.completion, value: p.handover },
  { label: labels.unitTypes, value: p.unitTypes },
  ...(p.priceFrom
    ? [{
        label: labels.priceFrom,
        value: p.priceFrom,
        // The figure is dated, never presented as permanent (§10).
        note: p.priceAsOf ? `${labels.priceAsOf} ${p.priceAsOf}` : undefined,
      }]
    : []),
];
---
{/* data-project carries this page's identity for M17 (Meta plumbing) to fire a
    ViewContent event against — the audience of "people who looked at THIS
    development" is the commercially valuable one. Inert until that module
    exists; see vault/website/m17-meta-plumbing.md. */}
<article class="prop" data-project={p.slug} data-project-name={p.project}>
  <header class="prop__head">
    <div class="prop__head-inner">
      <a class="prop__back" href="/properties">← {detailBack}</a>
      <p class="prop__developer">{p.developer}</p>
      <h1 class="prop__title">{p.project}</h1>

      {/* The facts strip — the projects area's own device. */}
      <dl class="prop__facts">
        {facts.map((f) => (
          <div class="prop__fact">
            <dt>{f.label}</dt>
            <dd>
              {f.value}
              {f.note && <span class="prop__fact-note">{f.note}</span>}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </header>

  <div class="prop__body">
    {p.image && (
      <Reveal index={0}>
        <img class="prop__img" src={p.image} alt={p.imageAlt ?? ''} decoding="async" />
      </Reveal>
    )}

    {/* The one serif moment on the page — the human sentence, given the room
        the grid card couldn't give it. */}
    <Reveal index={1}>
      <blockquote class="prop__why">
        <p class="prop__why-label">{labels.why}</p>
        <p class="prop__why-line">{p.why}</p>
      </blockquote>
    </Reveal>

    {p.detail && p.detail.length > 0 && (
      <div class="prop__prose">
        {p.detail.map((para, i) => (
          <Reveal index={2 + i}><p>{para}</p></Reveal>
        ))}
      </div>
    )}

    {p.permit && (
      <Reveal index={2 + (p.detail?.length ?? 0)}>
        <p class="prop__permit">{`${labels.permit} ${p.permit}`}</p>
      </Reveal>
    )}
  </div>
</article>

<style>
  /* ---- Navy head band ---- */
  .prop__head {
    background: var(--ground-dark);
    color: var(--text-on-dark);
    /* Clearance for the fixed header, from the header's OWN live measurement
       (it publishes --header-h). The fallback covers the frame before the script
       runs and any no-JS case. */
    padding: calc(var(--header-h, 6rem) + var(--space-3)) 0 var(--space-4);
  }
  .prop__head-inner,
  .prop__body {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .prop__back {
    display: inline-block;
    font-family: var(--font-util);
    font-size: var(--type-caption);
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--ivory) 70%, transparent);
    margin-bottom: var(--space-3);
  }
  .prop__back:hover { color: var(--ivory); }

  .prop__developer {
    font-family: var(--font-util);
    font-size: var(--type-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--gold-highlight);
    margin: 0 0 var(--space-1);
  }
  /* Inter, not Cinzel — the projects area's own voice. */
  .prop__title {
    font-family: var(--font-util);
    font-weight: 600;
    font-size: clamp(1.9rem, 4.5vw, 2.75rem);
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin: 0 0 var(--space-4);
  }

  /* Facts strip: label-over-value columns divided by hairlines. */
  .prop__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) 0;
    margin: 0;
    border-top: 1px solid color-mix(in srgb, var(--ivory) 18%, transparent);
    padding-top: var(--space-3);
  }
  .prop__fact {
    padding-right: var(--space-4);
    margin-right: var(--space-4);
    border-right: 1px solid color-mix(in srgb, var(--ivory) 18%, transparent);
  }
  .prop__fact:last-child { border-right: none; margin-right: 0; padding-right: 0; }
  .prop__facts dt {
    font-family: var(--font-util);
    font-size: 0.7rem;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ivory) 62%, transparent);
    margin-bottom: 0.3rem;
  }
  .prop__facts dd {
    font-family: var(--font-util);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--ivory);
    margin: 0;
  }
  .prop__fact-note {
    display: block;
    font-weight: 400;
    font-size: var(--type-caption);
    color: color-mix(in srgb, var(--ivory) 62%, transparent);
    margin-top: 0.2rem;
  }

  /* ---- Ivory body ---- */
  .prop__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-block: var(--space-6) var(--space-12);
  }

  .prop__img {
    width: 100%;
    max-width: 52rem;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  /* The centrepiece: the one serif on the page. Gold border = a use gold is
     allowed; the label uses the gold that may carry text on ivory. */
  .prop__why {
    max-width: 44rem;
    margin: 0;
    border-left: 2px solid var(--rule);
    padding-left: var(--space-3);
  }
  .prop__why-label {
    font-family: var(--font-util);
    font-size: var(--type-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-gold-safe);
    margin: 0 0 var(--space-1);
  }
  .prop__why-line {
    font-family: var(--font-body);
    font-style: italic;
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    line-height: 1.5;
    color: var(--text);
    margin: 0;
  }

  /* Supporting paragraphs stay in the page's functional voice. */
  .prop__prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 44rem;
  }
  .prop__prose p {
    font-family: var(--font-util);
    font-size: var(--type-body);
    line-height: 1.65;
    color: var(--text);
    margin: 0;
  }

  .prop__permit {
    font-family: var(--font-util);
    font-size: var(--type-caption);
    color: var(--text-muted);
    margin: 0;
  }
</style>
