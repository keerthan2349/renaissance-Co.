---
// M10 · Projects — the browse grid at /projects. REDESIGNED 28 Jul 2026 on the
// client's instruction: same theme as the main site, deliberately NOT the same
// UI. The homepage is an editorial single column set in serif; this page is a
// functional browsing surface —
//   · a navy page-header band instead of an ivory editorial head,
//   · Inter (the site's utility font) leading instead of Cinzel/Garamond,
//   · a responsive CARD GRID (which the homepage's rules deliberately avoid).
// The palette, gold discipline, motion rules and honesty rules are unchanged —
// that is the "same theme" half of the instruction. EB Garamond survives in
// exactly one place: the italic "why it is on the shelf" line on each card,
// so the one human sentence still reads warm against the functional grid.
//
// Renders nothing when there are no projects; the route generates no page then.
//
// REBUILT ON THE PAGE-BAND TEMPLATE (client, 3 Aug): the navy head band —
// marquee behind "N properties / The shelf" — is now templates/PageBand.astro,
// shared with every future page. The cards enter with the CURTAIN system
// (base.css + scripts/curtain.ts): revealed bottom-to-top, re-animating every
// time they leave the screen and return — the client's chosen entrance,
// deliberately different from the homepage's fire-once reveal.
import PageBand from '@/components/templates/PageBand.astro';
import { projects, projectsContent } from '@/data/projects';

const { shelfHeading, shelfIntro, labels } = projectsContent;
const count = projects.length;
const countLine = `${count} ${count === 1 ? 'property' : 'properties'}`;
---
{count > 0 && (
  <div class="browse">
    <PageBand eyebrow={countLine} title={shelfHeading} intro={shelfIntro} />

    <div class="browse__body">
      {/* data-curtain contract: direct children are the items; each clips its
          first element child (the card). --i staggers — modulo 6 so items deep
          in the grid don't queue a second of delay on every re-entry. */}
      <ul class="grid" role="list" data-curtain>
        {projects.map((p, i) => (
          <li style={`--i:${i % 6}`}>
            <a class="gcard" href={`/projects/${p.slug}`}>
              <div class="gcard__media">
                {p.image ? (
                  <img class="gcard__img" src={p.image} alt={p.imageAlt ?? ''} loading="lazy" decoding="async" />
                ) : (
                  <span class="gcard__blank" aria-hidden="true"></span>
                )}
                <p class="gcard__badge">{labels.completion}: {p.handover}</p>
              </div>
              <div class="gcard__body">
                <p class="gcard__developer">{p.developer}</p>
                <h2 class="gcard__name">{p.project}</h2>
                <p class="gcard__meta">
                  <svg class="gcard__pin" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <path d="M12 21s-7-5.5-7-11a7 7 0 1 1 14 0c0 5.5-7 11-7 11Z" />
                    <circle cx="12" cy="10" r="2.6" />
                  </svg>
                  {p.area} · {p.unitTypes}
                </p>
                <p class="gcard__why">{p.why}</p>
                {p.priceFrom && (
                  <p class="gcard__price">
                    <span class="gcard__price-label">{labels.priceFrom}</span>
                    <span class="gcard__price-value">{p.priceFrom}</span>
                  </p>
                )}
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
)}

<style>
  /* The head band's markup and styles live in templates/PageBand.astro now. */
  .browse__body {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* ---- The grid ---- */
  .browse__body { padding-block: var(--space-6) var(--space-12); }

  .grid {
    display: grid;
    /* min(15.5rem, 100%), not a bare 15.5rem: a fixed minimum makes the track
       wider than the container on very narrow screens and pushes the whole page
       into horizontal scroll. The min() collapses it to the container width. */
    grid-template-columns: repeat(auto-fill, minmax(min(15.5rem, 100%), 1fr));
    gap: var(--space-3);
  }

  /* Cards — the element the homepage deliberately never uses, which is exactly
     what makes this page read as a different surface. Hairline-bordered, not
     shadowed, so it stays this brand's kind of card. */
  .gcard {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--hairline);
    background: var(--ivory);
    transition: border-color var(--dur-micro) var(--ease);
  }
  .gcard:hover { border-color: var(--gold); }

  .gcard__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--navy);
  }
  .gcard__img,
  .gcard__blank {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform var(--dur-section) var(--ease);
  }
  .gcard__blank {
    background: linear-gradient(
      to top,
      var(--navy),
      color-mix(in srgb, var(--ivory) 10%, var(--navy))
    );
  }
  .gcard:hover .gcard__img { transform: scale(1.03); }

  .gcard__badge {
    position: absolute;
    top: var(--space-1);
    left: var(--space-1);
    margin: 0;
    padding: 0.4em 0.85em;
    border-radius: 999px;
    background: color-mix(in srgb, var(--navy) 88%, transparent);
    border: 1px solid color-mix(in srgb, var(--ivory) 22%, transparent);
    color: var(--ivory);
    font-family: var(--font-util);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
  }

  .gcard__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-3);
    gap: 0.45rem;
  }
  .gcard__developer {
    font-family: var(--font-util);
    font-size: 0.7rem;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-gold-safe);
    margin: 0;
  }
  .gcard__name {
    font-family: var(--font-util);
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: -0.005em;
    line-height: 1.25;
    color: var(--text);
    margin: 0;
  }
  .gcard:hover .gcard__name { text-decoration: underline; text-underline-offset: 3px; }
  .gcard__meta {
    display: flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-util);
    font-size: var(--type-caption);
    color: var(--text-muted);
    margin: 0;
  }
  .gcard__pin { flex: 0 0 auto; }

  /* The one serif on the page: the human sentence, clamped so cards stay even.
     The full line lives on the property's own page. */
  .gcard__why {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 0.97rem;
    line-height: 1.5;
    color: var(--text);
    margin: 0.15rem 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .gcard__price {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin: auto 0 0; /* pins to the card's bottom so price rows align across the grid */
    padding-top: var(--space-2);
    border-top: 1px solid var(--hairline);
    font-family: var(--font-util);
  }
  .gcard__price-label {
    font-size: var(--type-caption);
    color: var(--text-muted);
  }
  .gcard__price-value {
    font-weight: 600;
    font-size: 1rem;
    color: var(--text);
    white-space: nowrap;
  }
</style>
