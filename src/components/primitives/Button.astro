---
// Button — link or button. Navy/ivory only (never WhatsApp green, §7.9).
// variants: primary (navy fill), ghost (outline), text (underline draws on hover).
// weight: 'heavy' gives the phone — the conversion — more presence (§4.2).
interface Props {
  href?: string;
  variant?: 'primary' | 'ghost' | 'text';
  weight?: 'normal' | 'heavy';
  class?: string;
  'aria-label'?: string;
  rel?: string;
  target?: string;
}
const {
  href,
  variant = 'primary',
  weight = 'normal',
  class: className,
  ...rest
} = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag
  href={href}
  class:list={['btn', `btn--${variant}`, { 'btn--heavy': weight === 'heavy' }, className]}
  {...rest}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-util);
    font-size: var(--type-caption);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 500;
    transition:
      background var(--dur-micro) var(--ease),
      color var(--dur-micro) var(--ease),
      border-color var(--dur-micro) var(--ease);
  }
  .btn--primary {
    background: var(--navy);
    color: var(--ivory);
    padding: 0.9em 1.6em;
  }
  .btn--primary:hover { background: color-mix(in srgb, var(--navy) 86%, var(--ivory)); }
  /* On a dark section the navy fill would vanish into the ground, so the primary
     inverts: an ivory fill with navy text. This is what gives the phone — the
     conversion — a solid, prominent pill that pairs with the ghost WhatsApp. */
  :global(.section--dark) .btn--primary { background: var(--ivory); color: var(--navy); }
  :global(.section--dark) .btn--primary:hover { background: color-mix(in srgb, var(--ivory) 88%, var(--navy)); }

  .btn--ghost {
    border: 1px solid var(--navy);
    color: var(--navy);
    padding: 0.9em 1.6em;
  }
  .btn--ghost:hover { background: var(--navy); color: var(--ivory); }
  :global(.section--dark) .btn--ghost { border-color: var(--ivory); color: var(--ivory); }
  :global(.section--dark) .btn--ghost:hover { background: var(--ivory); color: var(--navy); }

  /* text link — underline draws from the left (§4.2). No lift, no shadow. */
  .btn--text {
    text-transform: none;
    letter-spacing: 0;
    font-size: inherit;
    font-family: inherit;
    position: relative;
    padding: 0;
  }
  .btn--text::after {
    content: '';
    position: absolute;
    left: 0; bottom: -2px;
    height: 1px; width: 100%;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-micro) var(--ease);
  }
  .btn--text:hover::after { transform: scaleX(1); }

  .btn--heavy { font-size: var(--type-lead); font-weight: 600; text-transform: none; letter-spacing: 0; }
</style>
