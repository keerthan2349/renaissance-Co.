---
// Section — the vertical rhythm wrapper. Sections are separated by whitespace
// and hairline/gold rules, never by boxes, cards or shadows (§4.3).
interface Props {
  id?: string;
  dark?: boolean;
  class?: string;
  as?: 'section' | 'div' | 'article' | 'footer' | 'header';
}
const { id, dark = false, class: className, as = 'section' } = Astro.props;
const Tag = as;
---
<Tag id={id} class:list={['section', { 'section--dark': dark }, className]}>
  <div class="section__inner">
    <slot />
  </div>
</Tag>

<style>
  .section {
    padding-block: var(--section-y);
    background: var(--ground);
    color: var(--text);
  }
  .section--dark {
    background: var(--ground-dark);
    color: var(--text-on-dark);
  }
  .section__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
