---
// Stat — a single figure. Takes a figure REFERENCE, never a literal number.
// It pulls value + verified date + source from the content layer, so a number
// cannot be typed into the page by hand (§4.4 / §4.5). If the figure isn't in
// src/content/figures/, the build fails — that is the honesty rule, enforced.
import { getEntry } from 'astro:content';
interface Props {
  figure: string;
  count?: boolean; // count up on entry (§4.2 counters) — decorative only
  class?: string;
}
const { figure, class: className } = Astro.props;
const entry = await getEntry('figures', figure);
if (!entry) {
  throw new Error(
    `Stat: figure "${figure}" not found in src/content/figures/. ` +
      `Every number on the site must exist in the content layer with a source and a verified date (CLAUDE.md).`,
  );
}
const { value, label, source, verifiedOn, note } = entry.data;
const verified = verifiedOn.toISOString().slice(0, 10);
---
<div class:list={['stat', className]}>
  <span class="stat__value">{value}</span>
  <span class="stat__label">{label}</span>
  {note && <span class="stat__note">{note}</span>}
  <span class="stat__meta">
    Verified {verified} · <a class="stat__source" href={source} target="_blank" rel="noopener noreferrer">source</a>
  </span>
</div>

<style>
  .stat { display: flex; flex-direction: column; gap: var(--space-1); }
  .stat__value {
    font-family: var(--font-display);
    font-size: var(--type-display-2);
    line-height: 1;
    color: inherit;
  }
  .stat__label {
    font-family: var(--font-body);
    font-size: var(--type-body);
    color: inherit;
  }
  .stat__note { font-family: var(--font-body); font-size: var(--type-caption); color: var(--text-muted); }
  .stat__meta {
    font-family: var(--font-util);
    font-size: var(--type-eyebrow);
    letter-spacing: 0.04em;
    color: var(--text-muted);
    margin-top: var(--space-1);
  }
  .stat__source { text-decoration: underline; text-underline-offset: 2px; }
  :global(.section--dark) .stat__note,
  :global(.section--dark) .stat__meta {
    color: color-mix(in srgb, var(--ivory) 68%, transparent);
  }
</style>
