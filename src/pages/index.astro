---
// Homepage. Renders exactly the modules named in page-order.ts, in order.
// Order is data (§ architecture): to reorder or drop a section, edit that list.
//
// Two modules are deliberately absent: M04 Refusal moved to /judgment when the
// projects carousel took the homepage (they may not share a page, blueprint §6),
// and M06 Off-plan moved to the bottom of /projects, where the shelf it explains
// actually is. Both are client decisions, 28 Jul 2026.
import Base from '@/layouts/Base.astro';
import Hero from '@/components/modules/M01-Hero/Hero.astro';
import Founder from '@/components/modules/M03-Founder/Founder.astro';
import Carousel from '@/components/modules/M10-Projects/Carousel.astro';
import WhatWeDo from '@/components/modules/M05-WhatWeDo/WhatWeDo.astro';
import Qualifications from '@/components/modules/M07-Qualifications/Qualifications.astro';
import Contact from '@/components/modules/M09-Contact/Contact.astro';
import Showcase from '@/components/modules/M18-Showcase/Showcase.astro';
import { pageOrder } from '@/data/page-order';

// Registry: maps a page-order id to its module. Add an id here only once its
// module exists (and to page-order.ts to make it render).
const registry = {
  hero: Hero,
  founder: Founder,
  projects: Carousel,
  'what-we-do': WhatWeDo,
  qualifications: Qualifications,
  contact: Contact,
  showcase: Showcase,
} as const;
---
<Base>
  {
    pageOrder.map((id) => {
      const Module = registry[id as keyof typeof registry];
      return Module ? <Module /> : null;
    })
  }
</Base>
