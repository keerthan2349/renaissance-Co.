---
// ⚠️ DEV-ONLY LAB ROUTE — BUILDS NOTHING IN PRODUCTION.
// Same guard as /lab/marquee and as the real /projects shelf: getStaticPaths
// returns an empty array outside `astro dev`, so a production build generates
// no page and the URL simply does not exist.
//
// Shows the showcase in its intended position — after "Call us", before the
// footer — with the real Qualifications and Contact sections above it so the
// scroll into and out of it is the real thing, not an isolated demo.
import Base from '@/layouts/Base.astro';
import Qualifications from '@/components/modules/M07-Qualifications/Qualifications.astro';
import Contact from '@/components/modules/M09-Contact/Contact.astro';
// The REAL module — promoted 2 Aug. This page is now just a tuning surface
// over it (rail length + frame shape for the future replacement film).
import Showcase from '@/components/modules/M18-Showcase/Showcase.astro';

export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return [{ params: { view: undefined } }];
}
---

<Base title="LAB · Showcase — Renaissance & Co. (dev only)">
  <div class="note">
    <p class="note__tag">Lab · not on the site</p>
    <h1 class="note__h">Scroll showcase</h1>
    <p class="note__p">
      This page opens on the <b>background layout</b> (your ask, 3 Aug): the film is already
      waiting full-screen <b>underneath the page</b> — as Call us scrolls away it <b>uncovers the
      film</b>, the film holds the screen as the background, then <b>the footer rises up and over
      it</b>. The film itself never moves: revealed, held, covered. The scroll ends the moment the
      footer lands. Tune it below, flip back to the current homepage look to compare, and tell me
      what to promote.
    </p>
    <div class="note__ctl">
      <div class="note__chips">
        <span>Layout</span>
        <button type="button" class="chip is-on" data-layout="bg">Background + footer over it</button>
        <button type="button" class="chip" data-layout="framed">Framed (current homepage)</button>
      </div>
      <div class="note__chips">
        <span>Line on the film</span>
        <button type="button" class="chip is-on" data-cap="left">Left, at the film's edge</button>
        <button type="button" class="chip" data-cap="center">Centred</button>
      </div>
    </div>
    <div class="note__ctl">
      <label for="hold">How long the film holds alone, before the footer rises <b id="hold-v">150vh</b></label>
      <input type="range" id="hold" min="0" max="400" step="10" value="150" />
    </div>
    <p class="note__p note__p--quiet">
      The 9:16 portrait film for phones gets wired in properly when you send the file — until then
      the landscape film centre-crops on mobile.
    </p>
  </div>

  <Qualifications />
  <Contact />

  <Showcase class="sc-lab" layout="background" />
</Base>

<style>
  .note {
    max-width: 72rem;
    margin-inline: auto;
    padding: calc(var(--header-h, 110px) + var(--space-6)) var(--gutter) var(--space-8);
    background: var(--ivory);
  }
  .note__tag {
    font-family: var(--font-util);
    font-size: var(--type-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-gold-safe);
    margin: 0 0 var(--space-1);
  }
  .note__h {
    font-family: var(--font-display);
    font-size: var(--type-display-2);
    font-weight: 400;
    margin: 0 0 var(--space-2);
  }
  .note__p {
    font-family: var(--font-body);
    font-size: var(--type-body);
    line-height: var(--leading-body);
    max-width: 44rem;
    margin: 0 0 var(--space-2);
  }
  .note__p--warn { color: var(--text-gold-safe); }
  .note__p--quiet { color: var(--text-muted); font-size: var(--type-caption); }
  .note__ctl {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-3) 0 var(--space-2);
    font-family: var(--font-util);
    font-size: var(--type-caption);
  }
  .note__ctl input[type='range'] { width: 14rem; accent-color: var(--gold-antique); }
  .note__ctl b { color: var(--text-gold-safe); }
  .note__chips { display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap; }
  .chip {
    font-family: var(--font-util);
    font-size: var(--type-caption);
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--hairline);
    border-radius: 2px;
    background: none;
    cursor: pointer;
    color: var(--navy);
  }
  .chip.is-on { background: var(--navy); color: var(--ivory); border-color: var(--navy); }
</style>

<script>
  function initShowcaseLab() {
    const hold = document.getElementById('hold') as HTMLInputElement | null;
    const sc = document.querySelector<HTMLElement>('.sc-lab');
    if (!hold || !sc || (hold as any).__wired) return;
    (hold as any).__wired = true;

    const out = document.getElementById('hold-v');
    const apply = () => {
      sc.style.setProperty('--sc-hold', `${hold.value}svh`);
      if (out) out.textContent = `${hold.value}vh`;
    };
    hold.addEventListener('input', apply);
    apply();

    // Layout: toggles the component's own .showcase--bg class — the same class
    // the layout="background" prop emits, so the lab exercises the exact code
    // that would ship, never a copy.
    document.querySelectorAll<HTMLElement>('.chip[data-layout]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.chip[data-layout]').forEach((c) => c.classList.remove('is-on'));
        btn.classList.add('is-on');
        sc.classList.toggle('showcase--bg', btn.dataset.layout === 'bg');
      });
    });

    // Caption alignment (full layout only): drives the component's own
    // --sc-cap-align custom property.
    document.querySelectorAll<HTMLElement>('.chip[data-cap]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.chip[data-cap]').forEach((c) => c.classList.remove('is-on'));
        btn.classList.add('is-on');
        sc.style.setProperty('--sc-cap-align', btn.dataset.cap!);
      });
    });
  }
  document.addEventListener('astro:page-load', initShowcaseLab);
  document.addEventListener('DOMContentLoaded', initShowcaseLab);
  initShowcaseLab();
</script>
